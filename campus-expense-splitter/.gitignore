# .gitignore for Campus Expense Splitter

# Environment variables
.env
.env.local
.env.*.local
.env.production.local

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Build output
frontend/build/
contracts/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
npm-debug.log
npm-debug.log.*
yarn-debug.log*
yarn-error.log*
*.log

# Testing
coverage/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache
